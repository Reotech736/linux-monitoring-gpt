# Phase 1では既定値の./prometheus.ymlを使用する。
# Phase 2でAMPへ送信する場合、次の2項目を設定した.envを作成する。
PROMETHEUS_CONFIG_FILE=./prometheus.amp.yml
AGENT_AWS_CREDENTIALS_FILE=/home/REPLACE_WITH_YOUR_USER/.config/linux-monitoring-gpt/aws/credentials
AGENT_AWS_CONFIG_FILE=/home/REPLACE_WITH_YOUR_USER/.config/linux-monitoring-gpt/aws/config
# Agentが認証ファイルを読めるよう、ホストの通常ユーザーUID/GIDを指定する。
AGENT_UID=1000
AGENT_GID=1000
