      "targets": [{"expr": "node_load1", "legendFormat": "1分", "refId": "A"}, {"expr": "node_load5", "legendFormat": "5分", "refId": "B"}, {"expr": "node_load15", "legendFormat": "15分", "refId": "C"}],
      "title": "ロードアベレージ",
